{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Context Orb local semantic assessment v1",
  "description": "A user-requested review of conversation context already visible to Codex. It is not an authoritative execution state. Stores also reject reports more than 60 seconds in the future and files larger than 32768 bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "session_id", "turn_id", "reviewed_at_ms", "compactions_observed", "coverage", "current_goal", "next_step", "review_note", "signals"],
  "properties": {
    "schema_version": {"const": 1},
    "source": {"const": "codex-skill-review"},
    "session_id": {"$ref": "#/$defs/identifier"},
    "turn_id": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
    "reviewed_at_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "compactions_observed": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 10000}, {"type": "null"}]},
    "coverage": {"enum": ["sufficient", "partial"]},
    "current_goal": {"$ref": "#/$defs/plainText", "minLength": 1, "maxLength": 500},
    "next_step": {"$ref": "#/$defs/plainText", "minLength": 1, "maxLength": 500},
    "review_note": {"type": "string", "maxLength": 1000, "not": {"pattern": "[\u0000-\u0009\u000b-\u001f\u007f-\u009f]"}},
    "signals": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/signal"}}
  },
  "$defs": {
    "plainText": {"type": "string", "not": {"pattern": "[\u0000-\u001f\u007f-\u009f]"}},
    "identifier": {"$ref": "#/$defs/plainText", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "note"],
      "properties": {
        "ref": {"$ref": "#/$defs/plainText", "minLength": 1, "maxLength": 160},
        "note": {"$ref": "#/$defs/plainText", "minLength": 1, "maxLength": 500}
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "summary", "status", "after_compaction", "affects_next_step", "recurrence", "confidence", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["goal_drift", "constraint_loss", "decision_conflict", "stale_fact", "repeated_work"]},
        "summary": {"$ref": "#/$defs/plainText", "minLength": 1, "maxLength": 240},
        "status": {"enum": ["open", "resolved"]},
        "after_compaction": {"type": "boolean"},
        "affects_next_step": {"type": "boolean"},
        "recurrence": {"enum": ["once", "after_correction"]},
        "confidence": {"enum": ["low", "medium", "high"]},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/evidence"}}
      }
    }
  }
}
